# ---------------------------------------------------------------------------
# Hero Particle Field
# ---------------------------------------------------------------------------
# Vite inlines these at dev-server / build start. Restart `npm run dev` after
# changing any value below for the changes to take effect.

# Shapes the particles morph through, in cycle order.
# Separator: |   Special keyword: "heart" (case-insensitive) renders the icon.
# Anything else is drawn as Fraunces bold text and sampled into points.
# Long words are auto-shrunk so they always fit horizontally.
# Examples:
#   VITE_PARTICLE_SHAPES=Felipe|FF.|heart
#   VITE_PARTICLE_SHAPES=Hire me|Developer|heart
#   VITE_PARTICLE_SHAPES=Hola|Available|heart|Felipe
VITE_PARTICLE_SHAPES=Felipe|FF.|heart

# Master toggle. Set to "false" to skip mounting the particle canvas entirely
# (useful for debugging or low-end machines).
VITE_PARTICLE_ENABLED=true

# Particle count override (positive integer). Leave blank to use the adaptive
# defaults — 6000 on phones, 14000 on tablets, 24000 on desktop.
VITE_PARTICLE_COUNT=
